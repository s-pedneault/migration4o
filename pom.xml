<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 
         http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    
    <groupId>com.gestiontechnologies</groupId>
    <artifactId>migration4o</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>
    
    <name>Migration4O</name>
    <description>DB4O Database Migration Assistant - A comprehensive tool for migrating DB4O databases to modern formats</description>
    
    <properties>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <main.class>ui.assistant.AssistantLauncher</main.class>
    </properties>
    
    <!-- Dependencies for IDE reference only - actual JARs are in lib/ directory -->
    <dependencies>
        <!-- DB4O Dependencies (local JARs) -->
        <dependency>
            <groupId>com.db4o</groupId>
            <artifactId>db4o-core</artifactId>
            <version>7.4.106</version>
            <scope>system</scope>
            <systemPath>${project.basedir}/lib/db4o-7.4.106.13438-java5.jar</systemPath>
        </dependency>
        
        <!-- Apache POI Dependencies (local JARs) -->
        <dependency>
            <groupId>org.apache.poi</groupId>
            <artifactId>poi</artifactId>
            <version>5.2.4</version>
            <scope>system</scope>
            <systemPath>${project.basedir}/lib/poi-5.2.4.jar</systemPath>
        </dependency>
        
        <dependency>
            <groupId>org.apache.poi</groupId>
            <artifactId>poi-ooxml</artifactId>
            <version>5.2.4</version>
            <scope>system</scope>
            <systemPath>${project.basedir}/lib/poi-ooxml-5.2.4.jar</systemPath>
        </dependency>
        
        <!-- Other local dependencies -->
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-collections4</artifactId>
            <version>4.4</version>
            <scope>system</scope>
            <systemPath>${project.basedir}/lib/commons-collections4-4.4.jar</systemPath>
        </dependency>
        
        <dependency>
            <groupId>commons-io</groupId>
            <artifactId>commons-io</artifactId>
            <version>2.15.1</version>
            <scope>system</scope>
            <systemPath>${project.basedir}/lib/commons-io-2.15.1.jar</systemPath>
        </dependency>
        
        <dependency>
            <groupId>org.apache.logging.log4j</groupId>
            <artifactId>log4j-api</artifactId>
            <version>2.20.0</version>
            <scope>system</scope>
            <systemPath>${project.basedir}/lib/log4j-api-2.20.0.jar</systemPath>
        </dependency>
    </dependencies>
    
    <!-- Note: This project uses a custom build script (build.sh) instead of Maven -->
    <!-- Dependencies are managed via lib/ directory -->
    <!-- This pom.xml is kept minimal for IDE compatibility -->
    
</project>